{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/arch7tect/cardreport/v0.9.1/src/cardreport/schemas/data-1.json",
  "title": "CardReport data/1",
  "description": "Structural contract used by the runtime and editors for named datasets. The YAML loader normalizes native date cells to this typed JSON representation.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "cardreport.data/1"
    },
    "datasets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/dataset"
      },
      "maxProperties": 32
    }
  },
  "required": [
    "format",
    "datasets"
  ],
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Literal, case-sensitive name; not a path or expression."
    },
    "typedCell": {
      "type": "object",
      "properties": {
        "$type": {
          "enum": [
            "decimal",
            "date",
            "datetime"
          ]
        },
        "value": {}
      },
      "required": [
        "$type",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "$type": {
                "const": "decimal"
              }
            },
            "required": [
              "$type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/decimal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "date"
              }
            },
            "required": [
              "$type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "datetime"
              }
            },
            "required": [
              "$type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/datetime"
              }
            }
          }
        }
      ],
      "description": "Lossless decimal, date or datetime; value must be a string. Datetimes without an offset mean UTC."
    },
    "cell": {
      "type": [
        "null",
        "string",
        "number",
        "object"
      ],
      "maxLength": 10000,
      "minimum": -1000000000000000.0,
      "maximum": 1000000000000000.0,
      "if": {
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/typedCell"
      }
    },
    "dataset": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/name"
            },
            "additionalProperties": {
              "$ref": "#/$defs/cell"
            },
            "maxProperties": 100
          },
          "maxItems": 2000
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "description": "Rows must have exactly the column keys; the runtime checks this relationship."
    },
    "decimal": {
      "type": "string",
      "maxLength": 10000,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
    },
    "date": {
      "type": "string",
      "maxLength": 10000,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
    },
    "datetime": {
      "type": "string",
      "maxLength": 10000,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})?(?![\\s\\S])"
    }
  }
}

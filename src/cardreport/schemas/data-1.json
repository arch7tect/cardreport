{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/arch7tect/cardreport/v0.6.0/src/cardreport/schemas/data-1.json",
  "title": "CardReport data/1",
  "description": "Named datasets using JSON-compatible cells. For native YAML dates, call datasets_from_yaml then datasets_to_json before external schema validation.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "cardreport.data/1"
    },
    "datasets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/dataset"
      },
      "maxProperties": 32
    }
  },
  "required": [
    "format",
    "datasets"
  ],
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Literal, case-sensitive name; not a path or expression."
    },
    "typedCell": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "$type": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "maxLength": 10000,
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            }
          },
          "required": [
            "$type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$type": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "maxLength": 10000,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          },
          "required": [
            "$type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$type": {
              "const": "datetime"
            },
            "value": {
              "type": "string",
              "maxLength": 10000,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "required": [
            "$type",
            "value"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Lossless decimal, date or timezone-aware datetime; value must be a string."
    },
    "cell": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 10000
        },
        {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        {
          "$ref": "#/$defs/typedCell"
        }
      ]
    },
    "dataset": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/name"
            },
            "additionalProperties": {
              "$ref": "#/$defs/cell"
            },
            "maxProperties": 100
          },
          "maxItems": 2000
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "description": "Rows must have exactly the column keys; the runtime checks this relationship."
    }
  }
}
